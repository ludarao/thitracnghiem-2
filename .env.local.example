# Database PostgreSQL MỚI cho app độc lập; không dùng URL của app cũ
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# URL trực tiếp cho migration, có thể dùng cùng URL nếu không qua pooler
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Mật khẩu admin ban đầu, ít nhất 10 ký tự; không có mật khẩu mặc định.
# Chỉ dùng để tạo tài khoản lần đầu. Sau đó đổi mật khẩu tại /admin.
ADMIN_PASSWORD=

# Khóa ký phiên riêng, ngẫu nhiên ít nhất 32 ký tự; bắt buộc cả khi tắt Turnstile.
EXAM_TOKEN_SECRET=

# Chỉ bật sau khi tạo widget Turnstile cho hostname của app mới.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
